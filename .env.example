# Porta do servidor
PORT=3000

# URL do Hermes API server (onde o Hermes gateway expõe o API server)
# Exemplo: http://127.0.0.1:8642
HERMES_URL=http://127.0.0.1:8642

# Chave de autenticação do Hermes API server (API_SERVER_KEY)
HERMES_API_KEY=

# Timeout para chamadas ao Hermes (segundos)
HERMES_TIMEOUT=120