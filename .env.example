# ═══════════════════════════════════════════════════════════════
# Hermes Remote — Configuração (copie para .env e preencha)
# ═══════════════════════════════════════════════════════════════
# NUNCA commite o .env — só este .env.example com placeholders.

# Porta do servidor
PORT=3000

# URL do Hermes API server (onde o Hermes gateway expõe o API server)
# Exemplo: http://127.0.0.1:8642
HERMES_URL=http://127.0.0.1:8642

# Chave de autenticação do Hermes API server (API_SERVER_KEY)
HERMES_API_KEY=

# Timeout para chamadas ao Hermes (segundos)
HERMES_TIMEOUT=120

# ── Infraestrutura (dashboard + ações) ──────────────────────────
# IPs tailnet (Tailscale) das máquinas — use os IPs 100.x.y.z reais
NOTEBOOK_IP=100.xx.xx.xx
HOMESERVER_IP=100.xx.xx.xx

# Usuário SSH para comandos remotos (nunca use nome real em repo público)
HOMESERVER_SSH_USER=usuario

# Path dos scripts do homeserver no servidor
HOMESERVER_PATH=/opt/homeserver

# Host de deploy (deploy.sh) — ex.: usuario@homeserver
HOMESERVER_HOST=usuario@homeserver
