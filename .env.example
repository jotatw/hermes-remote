# ═══════════════════════════════════════════════════════════════
# Hermes Remote — Configuração (copie para .env e preencha)
# ═══════════════════════════════════════════════════════════════
# NUNCA commite o .env — só este .env.example com placeholders.

# Porta do servidor
PORT=3000

# URL do Hermes API server (onde o Hermes gateway expõe o API server)
# Exemplo: http://127.0.0.1:8642
HERMES_URL=http://127.0.0.1:8642

# Chave de autenticação do Hermes API server (API_SERVER_KEY)
HERMES_API_KEY=

# Timeout para chamadas ao Hermes (segundos)
HERMES_TIMEOUT=120

# ── Segurança do gateway ────────────────────────────────────────
# Token opcional: se preenchido, toda rota /api/* (exceto health)
# exige "Authorization: Bearer <token>". Vazio = sem auth (v1).
GATEWAY_TOKEN=

# Origens permitidas no CORS (separadas por vírgula). Vazio = defaults.
#ALLOWED_ORIGINS=https://meu-pwa.ts.net,http://localhost:3002

# ── Infraestrutura (dashboard + ações) ──────────────────────────
# IPs tailnet (Tailscale) das máquinas — use os IPs 100.x.y.z reais
NOTEBOOK_IP=100.xx.xx.xx
HOMESERVER_IP=100.xx.xx.xx

# Usuário SSH para comandos remotos (nunca use nome real em repo público)
HOMESERVER_SSH_USER=usuario

# Path dos scripts do homeserver no servidor
HOMESERVER_PATH=/opt/homeserver

# Host de deploy (deploy.sh) — ex.: usuario@homeserver
HOMESERVER_HOST=usuario@homeserver

# ── Contrato de backend (comandos executados no servidor) ────────
# Sobrescreva conforme o SEU servidor. Defaults assumem um setup
# homeserver com scripts em HOMESERVER_PATH + scripts auxiliares do Hermes.
# Executado localmente se o app roda no homeserver, senão via SSH.

# Saúde (dashboard: temperatura) e Diário de saúde
#HS_HEALTH_CMD=bash /opt/homeserver/scripts/health-check.sh 2>/dev/null
#HS_DIARIO_CMD=bash /opt/homeserver/scripts/health-check.sh 2>/dev/null

# Agendamento de energia (deve emitir JSON: {dorme, acorda, ...})
#HS_POWER_CMD=sudo -n /opt/homeserver/core/hs.sh power status 2>/dev/null

# Code review (script do Hermes no servidor)
#HS_REVIEW_CMD=nohup bash /home/usuario/.hermes/scripts/code-review.sh > /dev/null 2>&1 & echo "ok"

# Dormir (suspender o servidor)
#HS_SLEEP_CMD=sudo /usr/sbin/rtcwake -m mem -t $(date -d "tomorrow 08:00" +%s) > /dev/null 2>&1 & echo ok

# Acordar (magic packet WOL)
#HS_WAKE_CMD=bash /home/usuario/.hermes/scripts/server-wol.sh 2>&1

# Containers (servidores sem Docker: deixe vazio). Formato: nome|status por linha.
#HS_CONTAINERS_CMD=docker ps -a --format '{{.Names}}|{{.Status}}' 2>/dev/null
